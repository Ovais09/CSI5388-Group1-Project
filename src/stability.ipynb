    "def evaluate_model(model, model_name,ds_name, ds_sets, fs, stable_features):\n",
    "    \"\"\"\n",
    "    Test the model performance using test set\n",
    "    \"\"\"\n",
    "    x_test = ds_sets[\"x_test\"][stable_features]\n",
    "    y_test = ds_sets[\"y_test\"]\n",
    "    y_pred = model.predict(x_test)\n",
    "\n",
    "    f1 = f1_score(y_test, y_pred)\n",
    "    prec = precision_score(y_test, y_pred)\n",
    "    rec = recall_score(y_test, y_pred)\n",
    "\n",
    "    return {\n",
    "        \"Dataset\": ds_name,\n",
    "        \"Model\": model_name,\n",
    "        \"FS Method\": fs, \n",
    "        \"F1\": f1,\n",
    "        \"Precision\": prec,\n",
    "        \"Recall\": rec\n",
    "    }\n",
    "    \n",
    "\n",
    "def save_test_results(all_test_results, model_name, ds_name):\n",
    "    \"\"\"\n",
    "    Saves the aggregated test results for all FS methods into one file.\n",
    "    \"\"\"\n",
    "    path = \"../results/phase_3/stability_reports/test_results\"\n",
    "    os.makedirs(path, exist_ok=True)\n",
    "    \n",
    "    # Convert the list of dictionaries into one DataFrame\n",
    "    summary_df = pd.DataFrame(all_test_results)\n",
    "    \n",
    "    filename = f\"{path}/{model_name}_{ds_name}_stability_test_report.csv\"\n",
    "    summary_df.to_csv(filename, index=False)\n",
    "    print(f\"Successfully saved Test Report: {filename}\")\n"
